#!/bin/sh
set -eu
export HOME=/tmp/profile DISPLAY=:0
mkdir -m 700 "$HOME"
Xvfb :0 -screen 0 1440x900x24 -nolisten tcp -ac &
socat TCP4-LISTEN:8080,bind=127.0.0.1,reuseaddr,fork UNIX-CONNECT:/session/app.sock &
for attempt in $(seq 1 100); do [ ! -S /tmp/.X11-unix/X0 ] || break; sleep 0.1; done
x11vnc -display :0 -localhost -forever -shared -nopw -noxdamage -rfbport 5900 -quiet &
for attempt in $(seq 1 150); do
    if socat -T1 -u OPEN:/dev/null TCP4:127.0.0.1:5900 2>/dev/null; then break; fi
    sleep 0.1
done
socat UNIX-LISTEN:/session/display.sock,mode=0600,fork TCP4:127.0.0.1:5900 &
# Chromium has no network, persistent profile, capabilities or host storage.
# The single application is reached through a session-specific Unix socket.
exec chromium --no-sandbox --disable-dev-shm-usage --disable-gpu --disable-background-networking \
    --no-first-run --no-default-browser-check --disable-extensions --window-size=1440,900 \
    --kiosk --app="$1"
