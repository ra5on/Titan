[Unit]
Description=Use available space on the Titan system disk safely
After=local-fs.target systemd-udev-trigger.service
Before=titan-firstboot.service titan-runtime.service titan-agent.service titan-web.service titan-proxy.service docker.service smb.service
RequiresMountsFor=/var /sysroot

[Service]
Type=oneshot
WorkingDirectory=/usr/lib/titan
ExecStart=-/usr/bin/python3 -m titan.system_disk --boot
TimeoutStartSec=5min
RemainAfterExit=yes
SELinuxContext=system_u:system_r:unconfined_service_t:s0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
