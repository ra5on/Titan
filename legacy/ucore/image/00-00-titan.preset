# CoreOS applies presets again on a fresh machine. Keep the NAS services enabled.
enable titan-firstboot.service
enable titan-system-grow.service
enable titan-runtime.service
enable titan-agent.service
enable titan-web.service
enable titan-proxy.service
enable titan-boot-status.timer
enable docker.service
enable firewalld.service
enable smb.service
enable virtqemud.socket
enable virtnetworkd.socket
enable virtstoraged.socket
enable virtlogd.socket
enable virtlockd.socket
enable virtnodedevd.socket
enable virtnwfilterd.socket
enable virtsecretd.socket
disable sshd.service
disable sshd.socket
disable zincati.service
disable bootc-fetch-apply-updates.timer
disable rpm-ostreed-automatic.timer
