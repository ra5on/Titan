module titan_proxy 1.0;
require {
    type unconfined_service_t;
    type httpd_exec_t;
    class file entrypoint;
}
# Fedora labels Caddy httpd_exec_t. Titan explicitly starts its proxy in the
# existing service domain; that domain's generic file access excludes entrypoint.
# Permit this one entrypoint rather than relabeling the packaged executable or
# disabling SELinux/NoNewPrivileges. Unix credentials and systemd sandbox remain.
allow unconfined_service_t httpd_exec_t:file entrypoint;
