[Unit]
Description=Report bounded Titan startup status on the local console
After=titan-firstboot.service titan-agent.service titan-web.service titan-proxy.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/share/titan/boot-status.sh
TimeoutStartSec=30
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=true
SELinuxContext=system_u:system_r:unconfined_service_t:s0
