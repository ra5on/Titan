# Titan is a complete uCore-HCI system. The base is pinned and updated deliberately.
FROM ghcr.io/ublue-os/ucore-hci@sha256:f872683cf4b57506ab034a18e47f6919fd72ce89f2def4424ee5262186d7e889
LABEL org.opencontainers.image.title="Titan" \
      org.opencontainers.image.description="Alpha NAS system on uCore-HCI" \
      org.opencontainers.image.source="https://github.com/ra5on/Titan"
RUN dnf -y install caddy python3 openssl acl util-linux smartmontools tar curl \
    ca-certificates kmod iproute e2fsprogs xfsprogs cloud-utils-growpart gdisk novnc python3-websockify \
    container-selinux policycoreutils-python-utils checkpolicy policycoreutils-devel && dnf clean all
COPY titan /usr/lib/titan/titan
COPY packaging /tmp/titan-packaging
COPY scripts/diagnose.sh scripts/component-functions.sh scripts/install-components.sh /usr/share/titan/
COPY image /tmp/titan-image
COPY LICENSE NOTICE /usr/share/doc/titan/
RUN TITAN_IMAGE_BUILD=1 bash /tmp/titan-image/install-image.sh && rm -rf /tmp/titan-packaging /tmp/titan-image
RUN ["bootc", "container", "lint"]
